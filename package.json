{
  "name": "organic-lab-mobile",
  "version": "0.2.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "ketcher-core": "^3.17.2",
    "ketcher-react": "^3.17.2",
    "ketcher-standalone": "^3.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sync-skills": "node scripts/sync-skills.mjs",
    "verify:provider": "node --env-file=.env.verify.local --import tsx scripts/verify-provider.mts",
    "verify:loop": "node --env-file=.env.verify.local --import tsx scripts/verify-loop.mts",
    "verify:vision": "node --env-file=.env.verify.local --import tsx scripts/verify-vision.mts",
    "sync-rdkit": "node scripts/sync-rdkit.mjs",
    "build:ketcher": "vite build --config ketcher-web/vite.config.mts",
    "postinstall": "node scripts/sync-rdkit.mjs",
    "verify:chem": "node --import tsx scripts/verify-chem.mts",
    "verify:retro": "node --env-file=.env.verify.local --import tsx scripts/verify-retro.mts",
    "verify:ui": "node --import tsx scripts/verify-ui.mts",
    "verify": "npm run verify:chem && npm run verify:bloom && npm run verify:context && npm run verify:photo && npm run verify:provider && npm run verify:vision && npm run verify:loop && npm run verify:retro && npm run verify:rescue",
    "verify:photo": "node --import tsx scripts/verify-photo.mts",
    "verify:rescue": "node --env-file=.env.verify.local --import tsx scripts/verify-rescue.mts",
    "build:blocks": "node --import tsx scripts/build-blocks.mts",
    "verify:context": "node --import tsx scripts/verify-context.mts",
    "verify:bloom": "node --import tsx scripts/verify-bloom.mts",
    "build:bb": "node --import tsx scripts/build-bb-index.mts"
  },
  "private": true,
  "description": "A local-first AI agent for organic photochemistry, running entirely on your phone.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lipz666/organic-lab-mobile.git"
  }
}